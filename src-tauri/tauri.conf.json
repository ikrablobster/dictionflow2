{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DictaFlow",
  "version": "0.2.1",
  "identifier": "com.dictaflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DictaFlow",
        "width": 860,
        "height": 650,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "center": true
      },
      {
        "label": "overlay",
        "title": "DictaFlow — диктовка",
        "url": "index.html?view=overlay",
        "width": 620,
        "height": 190,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": "ru-RU"
      },
      "nsis": {
        "languages": [
          "Russian",
          "Ukrainian",
          "English"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
